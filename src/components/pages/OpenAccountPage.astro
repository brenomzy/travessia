---
/**
 * Waitlist at /open-account. A minimal header, the copy on rio-negro, and the SignupForm on a white card over painted
 * clear water (C): from 1024 px the painting fills the right half, below it a band under the copy. The submit button
 * is the page's one accent. Replaced the vertical seam on 2026-11-21.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import MotionScript from '../ui/MotionScript.astro';
import Painting from '../ui/Painting.astro';
import SignupForm from '../islands/SignupForm';
import { lang } from '../../strings';
import { path } from '../../lib/routes';
import { getPage } from '../../lib/content';

interface Props {
}
const page = await getPage('openAccount');
---

<BaseLayout
 
  title={page.seo.title}
  description={page.seo.description}
  canonical={path('openAccount')}
  headerVariant="overlay"
  minimalHeader
>
  <section
    class="waitlist"
    data-theme="dark"
    aria-labelledby="page-title"
    data-reveal-intro
  >
    <div class="copy" data-reveal-stagger>
      <h1 id="page-title">{page.title}</h1>
      <p class="lead">{page.lead}</p>
      <ol class="steps" role="list">
        {
          page.steps.map((step, i) => (
            <li>
              <span class="n" aria-hidden="true">
                {i + 1}
              </span>
              {step}
            </li>
          ))
        }
      </ol>
    </div>
    <div class="form">
      <Painting kind="clear-water" shape="portrait" focus="50% 70%" sizes="(width >= 64rem) 50vw, 100vw" loading="eager" />
      <div class="card" data-theme="light">
        <SignupForm
          client:load
          lang={lang}
          privacyHref={path('privacy')}
          labels={{ ...page.form, success: page.success, toast: page.toast }}
        />
      </div>
    </div>
  </section>
</BaseLayout>

<MotionScript />

<style>
  .waitlist {
    display: grid;
    background-color: var(--color-bg-base);
  }

  .copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-l);
    padding: calc(var(--size-header) + var(--space-xl)) var(--space-gutter) var(--space-xl);
  }

  h1 {
    max-inline-size: 30rem;
    font-size: var(--text-5xl);
    line-height: var(--leading-5xl);
    letter-spacing: var(--tracking-5xl);
  }

  .lead {
    max-inline-size: 32rem;
    color: var(--color-text-muted);
    font-size: var(--text-lg);
    line-height: var(--leading-lg);
  }

  .steps {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
    max-inline-size: 31.25rem;
    padding-block-start: var(--space-l);
    border-block-start: var(--size-hairline) solid var(--color-border-base);
  }

  .steps li {
    display: flex;
    gap: var(--space-m);
  }

  .n {
    flex: 0 0 var(--space-s);
    color: var(--color-text-highlight);
    font-weight: var(--font-weight-semibold);
  }

  /* The painting behind the form card. */
  .form {
    position: relative;
    isolation: isolate;
    overflow: clip;
    padding: var(--space-2xl) var(--space-gutter);
    background-color: var(--color-bg-base);
  }

  /* SignupForm draws its own card; this only sets its width and its light colours. */
  .card {
    max-inline-size: 28.75rem;
    margin-inline: auto;
    background: none;
  }

  /* breakpoint.laptop (1024px): copy on the left in the content column, the painting fills the right half. */
  @media (width >= 64rem) {
    .waitlist {
      grid-template-columns: var(--page-inset) minmax(0, 1fr) minmax(0, 1fr);
      min-block-size: 56.25rem;
    }

    .copy > :where(*) {
      max-inline-size: 31.25rem;
    }

    .copy {
      grid-column: 2;
      align-self: center;
      padding-block: calc(var(--size-header) + var(--space-2xl)) var(--space-2xl);
      padding-inline: 0 var(--space-2xl);
    }

    .form {
      grid-column: 3;
      display: grid;
      align-items: center;
      padding: calc(var(--size-header) + var(--space-xl)) var(--space-2xl) var(--space-2xl);
    }
  }
</style>
