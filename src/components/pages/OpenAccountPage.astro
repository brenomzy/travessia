---
/**
 * Waitlist, shared by /abrir-conta and /en/open-account (Paper: Pages · product and sales → /abrir-conta).
 * A minimal header, the copy on noite and the SignupForm on tapajós across a vertical seam.
 * Below 1024 px the seam turns horizontal and the form follows the copy.
 */
import seamDesktop from '../../assets/textures/seam-50.png';
import seamMobile from '../../assets/textures/mobile-seam-v2.png';
import BaseLayout from '../../layouts/BaseLayout.astro';
import MotionScript from '../ui/MotionScript.astro';
import SignupForm from '../islands/SignupForm';
import { langTag, type Locale } from '../../i18n';
import { alternates, path } from '../../i18n/routes';
import { getPage } from '../../lib/content';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const page = await getPage(locale, 'openAccount');
---

<BaseLayout
  locale={locale}
  title={page.seo.title}
  description={page.seo.description}
  alternates={alternates('openAccount')}
  headerVariant="seam"
  minimalHeader
>
  <section
    class="waitlist"
    data-theme="dark"
    aria-labelledby="page-title"
    data-reveal-intro
    style={`--seam-desktop: url(${seamDesktop.src}); --seam-mobile: url(${seamMobile.src});`}
  >
    <div class="copy" data-reveal-stagger>
      <h1 id="page-title">{page.title}</h1>
      <p class="lead">{page.lead}</p>
      <ol class="steps" role="list">
        {
          page.steps.map((step, i) => (
            <li>
              <span class="n" aria-hidden="true">
                {i + 1}
              </span>
              {step}
            </li>
          ))
        }
      </ol>
    </div>
    <div class="band" aria-hidden="true"></div>
    <div class="form" data-theme="primary">
      <SignupForm
        client:load
        lang={langTag[locale]}
        privacyHref={path('privacy', locale)}
        labels={{ ...page.form, success: page.success, toast: page.toast }}
      />
    </div>
  </section>
</BaseLayout>

<MotionScript />

<style>
  .waitlist {
    display: grid;
    background-color: var(--color-bg-base);
  }

  .copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-l);
    padding: calc(var(--size-header) + var(--space-xl)) var(--space-gutter) var(--space-xl);
  }

  h1 {
    max-inline-size: 30rem;
    font-size: var(--text-5xl);
    line-height: var(--leading-5xl);
    letter-spacing: var(--font-tracking-display);
  }

  .lead {
    max-inline-size: 32rem;
    color: var(--color-text-muted);
    font-size: var(--text-lg);
    line-height: var(--leading-lg);
  }

  .steps {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
    max-inline-size: 31.25rem;
    padding-block-start: var(--space-l);
    border-block-start: var(--size-hairline) solid var(--color-border-base);
  }

  .steps li {
    display: flex;
    gap: var(--space-m);
  }

  .n {
    flex: 0 0 var(--space-s);
    color: var(--color-text-highlight);
    font-weight: var(--font-weight-semibold);
  }

  .band {
    min-block-size: var(--space-3xl);
    background-image: var(--seam-mobile);
    background-size: 100% auto;
    background-position: center 40%;
    image-rendering: pixelated;
  }

  .form {
    padding: var(--space-l) var(--space-gutter) var(--space-2xl);
    background-color: var(--color-bg-base);
  }

  .form > :global(*) {
    max-inline-size: 28.75rem;
    margin-inline: auto;
  }

  @media (width >= 64rem) {
    /* Paper: the seam texture is shifted 120 px of 1440 to the right; the copy is 500 px wide. */
    .waitlist {
      position: relative;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: center;
      min-block-size: 56.25rem;
      overflow: clip;
    }

    .waitlist::before {
      content: '';
      position: absolute;
      inset-block: 0;
      inset-inline-start: 8.33%;
      inline-size: 100%;
      background-image: var(--seam-desktop);
      background-size: cover;
      background-position: center;
      image-rendering: pixelated;
    }

    .copy,
    .form {
      position: relative;
    }

    .copy > :where(*) {
      max-inline-size: 31.25rem;
    }

    .copy {
      padding-block: calc(var(--size-header) + var(--space-2xl)) var(--space-2xl);
    }

    .band {
      display: none;
    }

    .form {
      padding: calc(var(--size-header) + var(--space-xl)) var(--space-gutter) var(--space-2xl);
      background: none;
    }
  }
</style>
