---
/** A blog category at /blog/category/[cat] (Paper: /blog/categoria/impostos). */
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../sections/Section.astro';
import Breadcrumb from '../ui/Breadcrumb.astro';
import PostCard from '../ui/PostCard.astro';
import ShowMore from '../ui/ShowMore.astro';
import MotionScript from '../ui/MotionScript.astro';
import { BLOG_COVERS } from '../../assets/imagery/blog-covers';
import { s } from '../../strings';
import { blogCategoryPath, path, postPath } from '../../lib/routes';
import { getPage, getPosts } from '../../lib/content';

interface Props {
  category: 'exchange' | 'taxes' | 'invoices' | 'guides' | 'news';
}
const { category } = Astro.props;
const page = await getPage('blog');
const posts = (await getPosts()).filter((p) => p.data.category === category);
const c = page.categories[category];
const cover = BLOG_COVERS[category];
const categoryIds = Object.keys(page.categories) as (keyof typeof page.categories)[];
---

<BaseLayout
 
  title={`${c.label} | ${page.title} | ${s.meta.siteName}`}
  description={c.lead}
  canonical={blogCategoryPath(c.slug)}
  headerVariant="dark"
  current="blog"
>
  <section class="hero" data-theme="tint" aria-labelledby="page-title" data-reveal-intro>
    <div class="l-container inner">
      <div class="copy" data-reveal-stagger>
        <Breadcrumb
          label={s.a11y.breadcrumb}
          items={[
            { label: page.title, href: path('blog') },
            { label: c.label, href: blogCategoryPath(c.slug) },
          ]}
        />
        <h1 id="page-title">{c.label}</h1>
        <p class="lead">{c.lead}</p>
      </div>
      <Image
        src={cover.src}
        alt=""
        widths={[640, 960, 1280]}
        sizes="(width >= 64rem) 45vw, 1px"
        format="webp"
        quality={85}
        class="panel"
        style={`object-position: ${cover.position}`}
      />
    </div>
  </section>

  <div class="bar">
    <div class="l-container bar-inner">
      <nav class="cats" aria-label={page.categoriesLabel}>
        <ul role="list">
          <li><a data-press href={path('blog')}>{page.all}</a></li>
          {
            categoryIds.map((id) => (
              <li>
                <a
                  href={blogCategoryPath(page.categories[id].slug)}
                  aria-current={id === category ? 'page' : undefined}
                >
                  {page.categories[id].label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <p class="count">{page.countShort.replace('{n}', String(posts.length))}</p>
    </div>
  </div>

  <Section spacing="after-strip" labelledby="page-title">
    <div class="l-stack" style="--gap: var(--space-xl)">
      <ul id="category-grid" class="grid" role="list" data-reveal-stagger data-dim-siblings>
        {
          posts.map((p) => (
            <PostCard
              post={p}
             
              href={postPath(p.data.slug)}
              categoryLabel={c.label}
              minutesLabel={page.minutes}
            />
          ))
        }
      </ul>
      <ShowMore targetId="category-grid" label={page.showMore} visible={6} total={posts.length} />
    </div>
  </Section>
</BaseLayout>

<MotionScript />

<style>
  .hero {
    position: relative;
    overflow: clip;
    padding-block: var(--space-2xl);
    background-color: var(--color-bg-base);
  }

  .hero :global(.panel) {
    display: none;
  }

  .copy {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-m);
    max-inline-size: 36rem;
  }

  h1 {
    font-size: var(--text-5xl);
    line-height: var(--leading-5xl);
    letter-spacing: var(--tracking-5xl);
  }

  .lead {
    color: var(--color-text-muted);
    font-size: var(--text-lg);
    line-height: var(--leading-lg);
  }

  @media (width >= 64rem) {
    .hero {
      min-block-size: 26rem;
      padding-block: var(--space-3xl);
    }

    /* Copy outside the image: the category's photo as a framed panel beside the copy (brand/rules.md). */
    .inner {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: var(--space-2xl);
      align-items: center;
    }

    .hero :global(.panel) {
      display: block;
      inline-size: 100%;
      block-size: auto;
      aspect-ratio: 1.6;
      object-fit: cover;
      border-radius: var(--radius-l);
      outline: var(--size-hairline) solid var(--color-ring);
      outline-offset: calc(var(--size-hairline) * -1);
    }
  }

  .bar {
    padding-block: var(--space-m);
    border-block-end: var(--size-hairline) solid var(--color-border-base);
  }

  .bar-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-s);
  }

  .cats {
    max-inline-size: 100%;
  }

  .cats ul {
    display: flex;
    gap: var(--space-2xs);
    overflow-x: auto;
    padding-block: var(--size-focus-ring);
    scrollbar-width: none;
  }

  .cats a {
    display: inline-block;
    padding: var(--space-2xs) var(--space-s);
    box-shadow: var(--shadow-1);
    border-radius: var(--radius-control);
    color: var(--color-text-base);
    font-size: var(--text-sm);
    text-decoration: none;
    white-space: nowrap;
  }

  .cats a:hover {
    border-color: var(--color-border-strong);
  }

  .cats a[aria-current] {
    border-color: var(--color-text-base);
    background-color: var(--color-text-base);
    color: var(--color-bg-base);
    font-weight: var(--font-weight-semibold);
  }

  .count {
    color: var(--color-text-subtle);
    font-size: var(--text-sm);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
    gap: var(--space-xl) var(--space-m);
  }
</style>
