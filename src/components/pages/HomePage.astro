---
/** Home, shared by / and /en/. Content comes from src/content/pages/<locale>/home.json and the collections. */
import BaseLayout from '../../layouts/BaseLayout.astro';
import HomeHero from '../sections/HomeHero.astro';
import StatBand from '../sections/StatBand.astro';
import CalculatorPreview from '../sections/CalculatorPreview.astro';
import FeatureGrid from '../sections/FeatureGrid.astro';
import CtaBand from '../sections/CtaBand.astro';
import { t, type Locale } from '../../i18n';
import { alternates, path, type RouteKey } from '../../i18n/routes';
import { getFeatures, getPage } from '../../lib/content';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const s = t(locale);
const page = await getPage(locale, 'home');
const features = await getFeatures(locale);
---

<BaseLayout
  locale={locale}
  title={page.seo.title}
  description={page.seo.description}
  alternates={alternates('home')}
  headerVariant="seam"
  current="home"
>
  <HomeHero locale={locale} content={page.hero} />
  <StatBand {...page.outcomes} />
  <CalculatorPreview {...page.calculator} currencyBRL={s.common.currencyBRL} />
  <FeatureGrid
    locale={locale}
    title={page.features.title}
    link={{ label: page.features.link.label, href: path(page.features.link.route as RouteKey, locale) }}
    features={features}
  />
  <CtaBand locale={locale} {...page.finalCta} />
</BaseLayout>
