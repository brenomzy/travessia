---
/** Home, shared by / and /en/. Section order follows Paper: Home → "Home · Desktop". */
import BaseLayout from '../../layouts/BaseLayout.astro';
import HomeHero from '../sections/HomeHero.astro';
import StatBand from '../sections/StatBand.astro';
import FeeCalculatorSection from '../sections/FeeCalculatorSection.astro';
import FeatureGrid from '../sections/FeatureGrid.astro';
import SeamStrip from '../sections/SeamStrip.astro';
import Showcase from '../sections/Showcase.astro';
import IntegrationsBento from '../sections/IntegrationsBento.astro';
import StoryCards from '../sections/StoryCards.astro';
import PricingTeaser from '../sections/PricingTeaser.astro';
import FaqList from '../sections/FaqList.astro';
import CtaBand from '../sections/CtaBand.astro';
import { t, type Locale } from '../../i18n';
import { alternates, path, type RouteKey } from '../../i18n/routes';
import { getFaqs, getFeatures, getIntegrations, getPage, getPlans, getRates, getStories } from '../../lib/content';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const s = t(locale);
const page = await getPage(locale, 'home');
const [features, integrations, stories, faqs, plans, rates] = await Promise.all([
  getFeatures(locale),
  getIntegrations(locale),
  getStories(locale, { featuredOnly: true }),
  getFaqs(locale, 'general'),
  getPlans(),
  getRates(),
]);
/** Every plan has the same conversion fee today; show the lowest. */
const feePercent = Math.min(...plans.map((p) => p.data.fee));
const to = (l: { label: string; route: string }) => ({ label: l.label, href: path(l.route as RouteKey, locale) });
---

<BaseLayout
  locale={locale}
  title={page.seo.title}
  description={page.seo.description}
  alternates={alternates('home')}
  headerVariant="seam"
  current="home"
>
  <HomeHero locale={locale} content={page.hero} />
  <StatBand {...page.outcomes} />
  <FeeCalculatorSection
    locale={locale}
    content={page.calculator}
    rates={rates}
    feePercent={feePercent}
    currencyBRL={s.common.currencyBRL}
  />
  <FeatureGrid locale={locale} title={page.features.title} link={to(page.features.link)} features={features} />
  <SeamStrip />
  <Showcase {...page.showcase} />
  <IntegrationsBento {...page.integrations} link={to(page.integrations.link)} integrations={integrations} />
  <StoryCards locale={locale} title={page.stories.title} link={to(page.stories.link)} stories={stories} />
  <PricingTeaser
    locale={locale}
    {...page.pricing}
    currencyBRL={s.common.currencyBRL}
    plans={plans}
    ctaHref={path('openAccount', locale)}
  />
  <FaqList {...page.faq} faqs={faqs} />
  <CtaBand locale={locale} {...page.finalCta} />
</BaseLayout>
