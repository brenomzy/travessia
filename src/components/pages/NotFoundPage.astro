---
/** 404 (Paper: Pages · company and utility → /404). From 1024 px the river still runs down the right: off course. */
import { Image } from 'astro:assets';
import river from '../../assets/generated/river/hero-river.png';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../ui/Icon.astro';
import { path, type RouteKey } from '../../lib/routes';
import { getPage } from '../../lib/content';

const page = await getPage('notFound');
---

<BaseLayout
 
  title={page.seo.title}
  description={page.seo.description}
  canonical="/404"
  headerVariant="dark"
>
  <section class="nf" data-theme="dark" aria-labelledby="page-title">
    <Image
      src={river}
      alt=""
      aria-hidden="true"
      widths={[960, 1440, 2160]}
      sizes="(width >= 64rem) 70vw, 1px"
      format="webp"
      class="river"
    />
    <div class="l-container">
      <div class="copy">
        <h1 id="page-title">{page.title}</h1>
        <p class="lead">{page.lead}</p>
        <ul role="list" class="links">
          {
            page.links.map((l) => (
              <li>
                <a href={path(l.route as RouteKey)}>
                  {l.label} <Icon name="arrow-right" />
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .nf {
    position: relative;
    isolation: isolate;
    overflow: clip;
    min-block-size: 40rem;
    padding-block: var(--space-3xl);
    background-color: var(--color-bg-base);
  }

  .copy {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-l);
    max-inline-size: 35rem;
  }

  h1 {
    font-size: var(--text-5xl);
    line-height: var(--leading-5xl);
    letter-spacing: var(--tracking-5xl);
  }

  .lead {
    color: var(--color-text-muted);
    font-size: var(--text-lg);
    line-height: var(--leading-lg);
  }

  .links {
    border-block-start: var(--size-hairline) solid var(--color-border-base);
  }

  .links a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: var(--space-s);
    border-block-end: var(--size-hairline) solid var(--color-border-base);
    color: var(--color-text-base);
    text-decoration: none;
    --icon-size: var(--size-icon-s);
  }

  .links a:hover {
    color: var(--color-text-highlight);
  }

  .river {
    display: none;
  }

  /* breakpoint.laptop (1024px): the river still on the right, faded in from the copy's side. */
  @media (width >= 64rem) {
    .river {
      display: block;
      position: absolute;
      inset-block: 0;
      inset-inline: 30% 0;
      z-index: -1;
      inline-size: 70%;
      block-size: 100%;
      object-fit: cover;
      object-position: 70% 50%;
      mask-image: linear-gradient(to right, transparent, var(--color-bg-base) 35%);
    }
  }
</style>
