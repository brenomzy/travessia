---
/**
 * Product overview rows (Paper: /produto → "Feature rows"): one row per feature, text beside its
 * vignette panel, alternating sides from 960 px. Text comes first on small screens.
 */
import type { CollectionEntry } from 'astro:content';
import Section from './Section.astro';
import Button from '../ui/Button.astro';
import FeatureVignette from '../product/FeatureVignette.astro';
import MotionScript from '../ui/MotionScript.astro';
import { featurePath } from '../../i18n/routes';
import type { Locale } from '../../i18n';

interface Props {
  locale: Locale;
  features: CollectionEntry<'features'>[];
}
const { locale, features } = Astro.props;
---

<Section>
  <ul class="rows" role="list">
    {
      features.map(({ data: f }, i) => (
        <li class="row" data-flip={i % 2 === 1 ? '' : undefined}>
          <div class="text" data-reveal-stagger>
            <h2>{f.name}</h2>
            <p class="intro">{f.intro}</p>
            <ul class="benefits" role="list">
              {f.benefits.map((b) => (
                <li>{b}</li>
              ))}
            </ul>
            <div>
              <Button variant="link" href={featurePath(f.slug, locale)} arrow>
                {f.linkLabel}
              </Button>
            </div>
          </div>
          <div class="panel" data-reveal>
            <FeatureVignette vignette={f.vignette} frame="panel" />
          </div>
        </li>
      ))
    }
  </ul>
</Section>

<MotionScript />

<style>
  .rows {
    display: flex;
    flex-direction: column;
    gap: var(--space-section);
  }

  .row {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
  }

  .text {
    display: flex;
    flex-direction: column;
    gap: var(--space-m);
  }

  h2 {
    font-size: var(--text-3xl);
    line-height: var(--leading-3xl);
    letter-spacing: var(--font-tracking-heading);
  }

  .intro {
    max-inline-size: var(--size-measure-text);
    color: var(--color-text-muted);
    font-size: var(--text-lg);
    line-height: var(--leading-lg);
  }

  .benefits {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    padding-block-start: var(--space-2xs);
  }

  .benefits + div {
    padding-block-start: var(--space-2xs);
  }

  @container (width >= 60rem) {
    .row {
      flex-direction: row;
      align-items: center;
      gap: var(--space-3xl);
    }

    .text {
      flex: 1 1 0;
    }

    .panel {
      flex: 0 1 40rem;
    }

    [data-flip] .panel {
      order: -1;
    }
  }
</style>
