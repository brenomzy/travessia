---
/**
 * Hero for interior pages. Light page, copy on the left, and from 1024 px a framed panel of painted clear water (C)
 * on the right with a piece of product UI on it ("copy outside the image", brand/rules.md). Below 1024 px the panel
 * follows the copy. The short size is a title band with no panel. Replaced the seam on 2026-11-21 (step 8).
 */
import Button from '../ui/Button.astro';
import Breadcrumb from '../ui/Breadcrumb.astro';
import MotionScript from '../ui/MotionScript.astro';
import Painting from '../ui/Painting.astro';

interface Props {
  title: string;
  lead: string;
  primary?: { label: string; href: string };
  secondary?: { label: string; href: string };
  /** short: a title band with no product UI (Paper: /precos "Short hero"). */
  size?: 'default' | 'short';
  /** The visual is decorative product UI by default. Set false when it holds a real form (events). */
  visualDecorative?: boolean;
  breadcrumb?: { label: string; items: { label: string; href?: string }[] };
}
const { title, lead, primary, secondary, breadcrumb, size = 'default', visualDecorative = true } = Astro.props;
const hasVisual = Astro.slots.has('visual');
---

<section class="hero" data-theme="light" aria-labelledby="page-title" data-reveal-intro data-size={size}>
  <div class="copy" data-reveal-stagger>
    {breadcrumb && <Breadcrumb label={breadcrumb.label} items={breadcrumb.items} />}
    <slot name="intro" />
    <h1 id="page-title">{title}</h1>
    <p class="lead">{lead}</p>
    <slot name="after-lead" />
    {
      (primary || secondary) && (
        <div class="actions">
          {primary && (
            <Button variant="accent" size="l" href={primary.href}>
              {primary.label}
            </Button>
          )}
          {secondary && (
            <Button variant="secondary" size="l" href={secondary.href}>
              {secondary.label}
            </Button>
          )}
        </div>
      )
    }
  </div>
  {
    hasVisual && (
      <div class="frame" data-reveal>
        <Painting kind="clear-water" focus="70% 50%" sizes="(width >= 64rem) 45vw, 100vw" loading="eager" />
        <div class="visual" aria-hidden={visualDecorative ? 'true' : undefined}>
          <slot name="visual" />
        </div>
      </div>
    )
  }
</section>

<MotionScript />

<style>
  .hero {
    display: grid;
    gap: var(--space-xl);
    padding: var(--space-xl) var(--space-gutter) var(--space-2xl);
    background-color: var(--color-bg-base);
  }

  .copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-m);
  }

  .copy > :where(*) {
    max-inline-size: 37.5rem;
  }

  h1 {
    font-size: var(--text-hero);
    line-height: var(--leading-hero);
    letter-spacing: var(--tracking-hero);
  }

  .lead {
    max-inline-size: 32.5rem;
    color: var(--color-text-muted);
    font-size: var(--text-lg);
    line-height: var(--leading-lg);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    padding-block-start: var(--space-3xs);
  }

  /* The painting panel: the product UI sits whole on the water, the frame crops the painting. */
  .frame {
    position: relative;
    isolation: isolate;
    display: grid;
    place-items: center;
    min-block-size: 22.5rem;
    padding: var(--space-2xl) var(--space-m);
    overflow: clip;
    border-radius: var(--radius-l);
  }

  .visual {
    inline-size: min(100%, 23.75rem);
  }

  [data-size='short'] .copy > :where(*) {
    max-inline-size: 45rem;
  }

  /* breakpoint.laptop (1024px): copy and panel side by side in the content column. */
  @media (width >= 64rem) {
    .hero {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: center;
      gap: var(--space-2xl);
      min-block-size: 33rem;
      padding: var(--space-l) var(--page-inset);
    }

    .copy {
      gap: var(--space-l);
      padding-block: var(--space-2xl);
    }

    .frame {
      align-self: stretch;
      min-block-size: 30rem;
    }

    [data-size='short'] {
      grid-template-columns: minmax(0, 1fr);
      min-block-size: 21.75rem;
    }
  }
</style>
