---
/**
 * Closing CTA for interior pages: the painted meeting (D), full bleed. The promise and the waitlist sit in its quiet
 * dark area, the conversion card rides the meeting itself. From 1024 px they are side by side (wide painting, quiet
 * left); below it they stack on the portrait painting (quiet top). Replaced the horizontal seam on 2026-11-21.
 */
import ConversionCard from '../product/ConversionCard.astro';
import WaitlistForm from '../ui/WaitlistForm.astro';
import MotionScript from '../ui/MotionScript.astro';
import Painting from '../ui/Painting.astro';
import { s } from '../../strings';

const c = s.closingCta;
---

<section class="closing" data-theme="dark" aria-labelledby="closing-title">
  <div class="art art-portrait"><Painting kind="meeting" shape="portrait" focus="50% 80%" /></div>
  <div class="art art-wide"><Painting kind="meeting" focus="40% 50%" /></div>
  <div class="copy" data-reveal-stagger>
    <h2 id="closing-title">{c.title}</h2>
    <p class="lead">{c.lead}</p>
    <WaitlistForm layout="inline" withName={false} showNotice />
  </div>
  <div class="card" aria-hidden="true" data-reveal>
    <ConversionCard {...c.card} shadow="floating-dark" />
  </div>
</section>

<MotionScript />

<style>
  .closing {
    position: relative;
    isolation: isolate;
    display: grid;
    gap: var(--space-3xl);
    overflow: clip;
    padding: var(--space-section) var(--space-gutter);
    background-color: var(--color-bg-base);
  }

  .art {
    position: absolute;
    inset: 0;
    z-index: -1;
    isolation: isolate;
  }

  /* Phones: the painting starts under the form and fades in, so the copy sits on plain dark water. */
  .art-portrait {
    inset-block-start: 35%;
    mask-image: linear-gradient(transparent, var(--color-bg-base) 25%);
  }

  .art-wide {
    display: none;
  }

  .copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-m);
    max-inline-size: 32rem;
  }

  h2 {
    font-size: var(--text-hero);
    line-height: var(--leading-hero);
    letter-spacing: var(--tracking-hero);
  }

  .lead {
    color: var(--color-text-muted);
    font-size: var(--text-lg);
    line-height: var(--leading-lg);
  }

  .card {
    justify-self: center;
    inline-size: min(100%, 21.25rem);
  }

  /* breakpoint.laptop (1024px) */
  @media (width >= 64rem) {
    .closing {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: center;
      min-block-size: 40rem;
      padding-inline: var(--page-inset);
    }

    .art-portrait {
      display: none;
    }

    .art-wide {
      display: block;
    }
  }
</style>
