---
/**
 * Closing CTA for interior pages (Paper: "Final CTA B · Horizontal crossing"): the promise on noite,
 * a conversion card riding the horizontal seam, and the waitlist on tapajós below it.
 * Home keeps its own CTA (CtaBand), with the vertical seam.
 */
import hseam from '../../assets/textures/hseam.png';
import ConversionCard from '../product/ConversionCard.astro';
import WaitlistForm from '../ui/WaitlistForm.astro';
import MotionScript from '../ui/MotionScript.astro';
import { t, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const c = t(locale).closingCta;
---

<section class="closing" data-theme="dark" aria-labelledby="closing-title" style={`--hseam: url(${hseam.src});`}>
  <h2 id="closing-title" data-reveal>{c.title}</h2>
  <div class="card" aria-hidden="true" data-reveal>
    <ConversionCard {...c.card} shadow="floating-dark" />
  </div>
  <div class="join" data-theme="primary" data-reveal>
    <WaitlistForm locale={locale} layout="inline" withName={false} showNotice />
  </div>
</section>

<MotionScript />

<style>
  .closing {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-xl);
    min-block-size: 40rem;
    padding: var(--space-2xl) var(--page-inset);
    background-color: var(--color-bg-base);
    background-image: var(--hseam);
    background-size: cover;
    background-position: center;
    image-rendering: pixelated;
    text-align: center;
  }

  h2 {
    max-inline-size: 56.25rem;
    font-size: var(--text-hero);
    line-height: var(--leading-hero);
    letter-spacing: var(--font-tracking-display);
  }

  .card {
    inline-size: min(100%, 21.25rem);
    text-align: start;
  }

  .join {
    inline-size: min(100%, 35rem);
    background: none;
  }
</style>
