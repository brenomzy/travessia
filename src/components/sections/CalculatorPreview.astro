---
/**
 * "Quanto vou receber?" (Paper: Home → Section · Calculator).
 * Static for now: the FeeCalculator island (Base UI NumberField + Select, Motion count-up) replaces the card in Phase 2.
 */
import Section from './Section.astro';
import Icon from '../ui/Icon.astro';

interface Props {
  title: string;
  lead: string;
  points: string[];
  currencies: string[];
  amountLabel: string;
  amount: string;
  currency: string;
  rows: { label: string; value: string }[];
  resultLabel: string;
  result: string;
  arrival: string;
  disclaimer: string;
  currencyBRL: string;
}
const p = Astro.props;
---

<Section theme="tint" labelledby="calculator-title">
  <div class="layout">
    <div class="copy">
      <h2 id="calculator-title">{p.title}</h2>
      <p class="lead">{p.lead}</p>
      <ul role="list">
        {
          p.points.map((point) => (
            <li>
              <Icon name="check-circle" />
              {point}
            </li>
          ))
        }
      </ul>
    </div>
    <div class="card" data-theme="light">
      <div class="tabs" aria-hidden="true">
        {p.currencies.map((c, i) => <span data-selected={i === 0 ? '' : undefined}>{c}</span>)}
      </div>
      <div class="field">
        <p class="label">{p.amountLabel}</p>
        <p class="input"><span>{p.amount}</span><span class="unit">{p.currency}</span></p>
      </div>
      <dl class="rows">
        {
          p.rows.map((r) => (
            <div>
              <dt>{r.label}</dt>
              <dd>{r.value}</dd>
            </div>
          ))
        }
      </dl>
      <div class="result" data-theme="deep">
        <div>
          <p class="label">{p.resultLabel}</p>
          <p class="sum"><span>{p.currencyBRL}</span> {p.result}</p>
        </div>
        <p class="arrival">{p.arrival}</p>
      </div>
      <p class="disclaimer">{p.disclaimer}</p>
    </div>
  </div>
</Section>

<style>
  .layout {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2xl) var(--space-3xl);
  }

  .copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-m);
    flex: 1 1 22rem;
    max-inline-size: 31.25rem;
  }

  .lead {
    color: var(--color-text-muted);
    font-size: var(--text-lg);
    line-height: var(--leading-lg);
  }

  ul {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    padding-block-start: var(--space-xs);
  }

  li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-xs);
    --icon-size: var(--size-icon-m);
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: var(--space-m);
    flex: 1 1 24rem;
    max-inline-size: 37.5rem;
    padding: var(--space-l);
    border-radius: var(--radius-l);
    background-color: var(--color-bg-raised);
    box-shadow: var(--shadow-2);
  }

  .tabs {
    display: flex;
    align-self: flex-start;
    gap: var(--space-3xs);
    padding: var(--space-3xs);
    border-radius: var(--radius-pill);
    background-color: var(--color-chip-bg);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-medium);
  }

  .tabs span {
    padding: var(--space-2xs) var(--space-s);
    border-radius: var(--radius-pill);
  }

  .tabs [data-selected] {
    background-color: var(--color-text-base);
    color: var(--color-bg-base);
    font-weight: var(--font-weight-semibold);
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
  }

  .label {
    color: var(--color-text-subtle);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-medium);
  }

  .input {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-s) var(--space-m);
    border: var(--size-focus-ring) solid var(--color-border-strong);
    border-radius: var(--radius-m);
    font-size: var(--text-3xl);
    line-height: var(--leading-3xl);
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--font-tracking-title);
    font-variant-numeric: tabular-nums;
  }

  .unit {
    font-size: var(--text-lg);
    letter-spacing: var(--font-tracking-normal);
  }

  .rows {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .rows div {
    display: flex;
    justify-content: space-between;
    gap: var(--space-s);
  }

  dt {
    color: var(--color-text-muted);
  }

  dd {
    margin: 0;
    font-weight: var(--font-weight-semibold);
    font-variant-numeric: tabular-nums;
    text-align: end;
  }

  .result {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-xs);
    padding: var(--space-m) var(--space-m);
    border-radius: var(--radius-m);
    background-color: var(--color-bg-base);
  }

  .result .label {
    color: var(--color-text-muted);
  }

  .sum {
    font-size: var(--text-4xl);
    line-height: var(--leading-4xl);
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--font-tracking-heading);
    font-variant-numeric: tabular-nums;
  }

  .sum span {
    font-size: var(--text-xl);
  }

  .arrival {
    padding-block-end: var(--space-2xs);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-medium);
  }

  .disclaimer {
    color: var(--color-text-subtle);
    font-size: var(--text-xs);
    line-height: var(--leading-xs);
  }
</style>
