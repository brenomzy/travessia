---
/**
 * Final CTA on the home page: the painted meeting (D), full bleed, with the promise and the waitlist in its quiet
 * dark area ("quiet zone", brand/rules.md). From 1024 px the painting is the wide one (quiet left); below it the
 * portrait one (quiet top), with room under the form for the meeting to show. Replaced the seam on 2026-11-21.
 */
import WaitlistForm from '../ui/WaitlistForm.astro';
import MotionScript from '../ui/MotionScript.astro';
import Painting from '../ui/Painting.astro';

interface Props {
  title: string;
  lead: string;
}
const { title, lead } = Astro.props;
---

<section class="cta" data-theme="dark" aria-labelledby="cta-title">
  <div class="art art-portrait"><Painting kind="meeting" shape="portrait" focus="50% 70%" /></div>
  <div class="art art-wide"><Painting kind="meeting" focus="40% 50%" /></div>
  <div class="content" data-reveal-stagger>
    <h2 id="cta-title">{title}</h2>
    <p class="lead">{lead}</p>
    <WaitlistForm layout="inline" showNotice />
  </div>
</section>

<MotionScript />

<style>
  .cta {
    position: relative;
    isolation: isolate;
    overflow: clip;
    padding: var(--space-section) var(--space-gutter) calc(var(--space-section) * 3);
    background-color: var(--color-bg-base);
  }

  .art {
    position: absolute;
    inset: 0;
    z-index: -1;
    isolation: isolate;
  }

  /* Phones: the painting starts under the form and fades in, so the copy sits on plain dark water. */
  .art-portrait {
    inset-block-start: 40%;
    mask-image: linear-gradient(transparent, var(--color-bg-base) 25%);
  }

  .art-wide {
    display: none;
  }

  .content {
    display: flex;
    flex-direction: column;
    gap: var(--space-m);
    max-inline-size: 30.5rem;
  }

  h2 {
    font-size: var(--text-hero);
    line-height: var(--leading-hero);
    letter-spacing: var(--tracking-hero);
  }

  .lead {
    color: var(--color-text-muted);
    font-size: var(--text-lg);
    line-height: var(--leading-lg);
  }

  /* breakpoint.laptop (1024px) */
  @media (width >= 64rem) {
    .cta {
      display: grid;
      align-items: center;
      min-block-size: 37.5rem;
      padding: var(--space-section) var(--page-inset);
    }

    .art-portrait {
      display: none;
    }

    .art-wide {
      display: block;
    }
  }
</style>
