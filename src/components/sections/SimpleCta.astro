---
/**
 * A dark band with a promise and one button (for-clients closing CTA). From 1024 px the painted meeting (D) fills
 * the right of the band, its quiet left under the copy. Replaced the seam on 2026-11-21.
 */
import Button from '../ui/Button.astro';
import MotionScript from '../ui/MotionScript.astro';
import Painting from '../ui/Painting.astro';

interface Props {
  title: string;
  link: { label: string; href: string };
}
const { title, link } = Astro.props;
---

<section class="cta" data-theme="dark" aria-labelledby="cta-title">
  <div class="art"><Painting kind="meeting" focus="30% 50%" sizes="(width >= 64rem) 60vw, 1px" /></div>
  <div class="l-container">
    <div class="copy" data-reveal-stagger>
      <h2 id="cta-title">{title}</h2>
      <div><Button variant="accent" size="l" href={link.href}>{link.label}</Button></div>
    </div>
  </div>
</section>

<MotionScript />

<style>
  .cta {
    position: relative;
    isolation: isolate;
    overflow: clip;
    padding-block: var(--space-2xl);
    background-color: var(--color-bg-base);
  }

  .copy {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-l);
    max-inline-size: 36rem;
  }

  h2 {
    font-size: var(--text-4xl);
    line-height: var(--leading-4xl);
    letter-spacing: var(--tracking-4xl);
  }

  .art {
    display: none;
  }

  /* breakpoint.laptop (1024px): the painting covers the band from 35%, its dark side behind the copy. */
  @media (width >= 64rem) {
    .art {
      display: block;
      position: absolute;
      inset-block: 0;
      inset-inline: 35% 0;
      z-index: -1;
      isolation: isolate;
      mask-image: linear-gradient(to right, transparent, var(--color-bg-base) 30%);
    }
  }
</style>
