---
/**
 * Inline SVG icons from the Hugeicons stroke-rounded set (src/lib/icons, brand/rules.md "Icons"). They draw in
 * currentColor at 1.5 on a 24 px grid; the size comes from --icon-size. check-circle is ours: the check on an
 * igarapé disc, for a done state.
 */
import { ICONS, svgAttributes, type IconName } from '../../lib/icons';

interface Props {
  name: IconName | 'check-circle';
  /** Accessible name; omit for decorative icons. */
  label?: string;
  class?: string;
}
const { name, label, class: className } = Astro.props;
const drawing = ICONS[name === 'check-circle' ? 'check' : name];
---

<svg
  class:list={['icon', className]}
  data-name={name}
  viewBox="0 0 24 24"
  xmlns="http://www.w3.org/2000/svg"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
>
  {name === 'check-circle' && <circle cx="12" cy="12" r="12" class="disc" />}
  {
    drawing.map(([Tag, attrs]) => {
      const El = Tag as 'path';
      return <El {...svgAttributes(attrs)} />;
    })
  }
</svg>

<style>
  .icon {
    inline-size: var(--icon-size, var(--size-icon-s));
    block-size: var(--icon-size, var(--size-icon-s));
    flex-shrink: 0;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .disc {
    fill: var(--color-accent-data);
    stroke: none;
  }

  /* The check sits smaller inside its disc. */
  [data-name='check-circle'] :not(.disc) {
    stroke: var(--color-on-data);
    stroke-width: 2;
    transform: scale(0.62);
    transform-origin: center;
  }
</style>
