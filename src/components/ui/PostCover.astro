---
/**
 * A blog cover: the category's image, the title on its calm left side, the wordmark and the category at the bottom.
 * Exchange uses the painted meeting; the other categories use photographs (step 9), which take the soft rio-negro
 * scrim behind the title. Titles stay real HTML text. The ring sits inside the edge so dark photos keep their shape
 * on dark grounds and misty ones on white (Paper: Brand · Photography → "5 · Picks on white and rio-negro").
 */
import { Image } from 'astro:assets';
import Logo from './Logo.astro';
import { BLOG_COVERS, type BlogCoverCategory } from '../../assets/imagery/blog-covers';

interface Props {
  category: BlogCoverCategory;
  categoryLabel: string;
  title?: string;
  /** card: grid cards. feature: the big one on the blog index. banner: a post's header image, no text. */
  size?: 'card' | 'feature' | 'banner';
}
const { category, categoryLabel, title, size = 'card' } = Astro.props;
const cover = BLOG_COVERS[category];
---

<div class="cover" data-size={size} data-theme="dark">
  <Image
    src={cover.src}
    alt=""
    widths={size === 'card' ? [480, 800] : [800, 1200, 1600]}
    sizes={size === 'card' ? '(width >= 64rem) 26rem, 100vw' : '(width >= 64rem) 60vw, 100vw'}
    format="webp"
    quality={85}
    class="image"
    style={`object-position: ${cover.position}`}
  />
  {cover.scrim && size !== 'banner' && <span class="scrim" aria-hidden="true" />}
  {
    size !== 'banner' && (
      <>
        {title && <span class="title">{title}</span>}
        <span class="brand">
          <Logo tone="dark" label="" class="logo" />
          <span class="sep" aria-hidden="true" />
          <span class="category">{categoryLabel}</span>
        </span>
      </>
    )
  }
</div>

<style>
  .cover {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    aspect-ratio: 1.9;
    overflow: hidden;
    padding: var(--space-m);
    border-radius: var(--radius-m);
    background-color: var(--color-bg-base);
    color: var(--color-text-base);
  }

  /* The ring inside the edge, drawn over the image. */
  .cover {
    outline: var(--size-hairline) solid var(--color-ring);
    outline-offset: calc(var(--size-hairline) * -1);
  }

  .image {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }

  .scrim {
    position: absolute;
    inset: 0;
    background-image: linear-gradient(to right, var(--color-scrim-image), transparent 50%);
  }

  .title {
    position: relative;
    max-inline-size: 45%;
    font-size: var(--text-xl);
    line-height: var(--leading-xl);
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--tracking-xl);
  }

  .brand {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    font-size: var(--text-xs);
    line-height: var(--leading-xs);
    font-weight: var(--font-weight-medium);
  }

  .brand :global(.logo) {
    inline-size: calc(var(--size-logo-nav) * 0.5);
    block-size: auto;
  }

  .sep {
    inline-size: var(--size-hairline);
    block-size: var(--space-s);
    background-color: var(--color-border-base);
  }

  .category {
    color: var(--color-text-highlight);
  }

  [data-size='feature'] {
    aspect-ratio: 1.9;
    padding: var(--space-l);
    border-radius: var(--radius-l);
  }

  [data-size='feature'] .title {
    max-inline-size: 42%;
    font-size: var(--text-3xl);
    line-height: var(--leading-3xl);
    letter-spacing: var(--tracking-3xl);
  }

  [data-size='banner'] {
    aspect-ratio: 2.7;
    border-radius: var(--radius-l);
  }
</style>
