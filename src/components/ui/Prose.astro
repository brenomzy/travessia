---
/**
 * Styles for rendered Markdown (SPEC §5.5.4): stories, blog posts and legal pages. Wraps the
 * <Content /> from an entry. Headings get ids from Astro, which the TocNav links to.
 */
interface Props {
  size?: 'default' | 'large';
}
const { size = 'default' } = Astro.props;
---

<div class="prose" data-size={size}><slot /></div>

<style>
  .prose {
    max-inline-size: var(--size-measure-text);
    color: var(--color-text-muted);
  }

  .prose > :global(* + *) {
    margin-block-start: var(--space-m);
  }

  .prose :global(h2) {
    margin-block-start: var(--space-2xl);
    color: var(--color-text-base);
    font-size: var(--text-2xl);
    line-height: var(--leading-2xl);
    letter-spacing: var(--font-tracking-heading);
    scroll-margin-block-start: calc(var(--size-header) + var(--space-l));
  }

  .prose :global(h2:first-child) {
    margin-block-start: 0;
  }

  .prose :global(h3) {
    margin-block-start: var(--space-xl);
    color: var(--color-text-base);
    font-size: var(--text-xl);
    line-height: var(--leading-xl);
  }

  .prose :global(h2 + *),
  .prose :global(h3 + *) {
    margin-block-start: var(--space-s);
  }

  .prose[data-size='large'] {
    font-size: var(--text-lg);
    line-height: var(--leading-lg);
  }

  .prose :global(a) {
    color: var(--color-link);
  }

  .prose :global(strong) {
    color: var(--color-text-base);
  }

  /* A pull quote: the quote large, the last line (who said it) small. */
  .prose :global(blockquote) {
    margin-block: var(--space-xl);
    padding: var(--space-l);
    border-radius: var(--radius-l);
    background-color: var(--color-chip-bg);
    color: var(--color-text-base);
  }

  .prose :global(blockquote p:first-child) {
    font-size: var(--text-xl);
    line-height: var(--leading-xl);
    font-weight: var(--font-weight-medium);
    letter-spacing: var(--font-tracking-title);
  }

  .prose :global(blockquote p + p) {
    margin-block-start: var(--space-s);
    color: var(--color-text-subtle);
    font-size: var(--text-sm);
  }

  /* A callout: a paragraph that starts with "Nota:" style emphasis uses an aside in Markdown via HTML. */
  .prose :global(aside) {
    padding: var(--space-m) var(--space-l);
    border: var(--size-hairline) solid var(--color-border-base);
    border-inline-start: var(--size-focus-ring) solid var(--color-accent-data);
    border-radius: var(--radius-m);
    color: var(--color-text-base);
    font-size: var(--text-sm);
    line-height: var(--leading-sm);
  }

  .prose :global(ol),
  .prose :global(ul) {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    padding-inline-start: var(--space-l);
  }

  .prose :global(ol) {
    list-style: none;
    counter-reset: step;
    padding-inline-start: 0;
  }

  .prose :global(ol li) {
    display: flex;
    gap: var(--space-s);
    counter-increment: step;
  }

  .prose :global(ol li::before) {
    content: counter(step);
    flex: 0 0 var(--space-s);
    color: var(--color-accent-data-strong);
    font-weight: var(--font-weight-semibold);
  }

  /* Tables shrink to fit a phone: tighter cells and smaller type; numbers may wrap at their spaces. */
  .prose :global(table) {
    inline-size: 100%;
    border-collapse: collapse;
    font-size: var(--text-xs);
    font-variant-numeric: tabular-nums;
  }

  @media (width >= 48rem) {
    .prose :global(table) {
      font-size: var(--text-sm);
    }

    .prose :global(th),
    .prose :global(td) {
      padding-inline: var(--space-s);
    }
  }

  .prose :global(th),
  .prose :global(td) {
    padding: var(--space-xs) var(--space-2xs);
    border-block-end: var(--size-hairline) solid var(--color-border-base);
    text-align: start;
  }

  .prose :global(thead th) {
    background-color: var(--color-chip-bg);
    color: var(--color-text-base);
    font-weight: var(--font-weight-semibold);
  }

  .prose :global(td:not(:first-child)),
  .prose :global(th:not(:first-child)) {
    text-align: end;
  }
</style>
