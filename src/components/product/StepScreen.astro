---
/**
 * The product screen under a step (Paper: "Steps A · One track, a screen per step"). form: labelled fields and
 * suggestions. message: an email. status: a titled list with one highlighted row and an optional total. All three
 * line up across the track through StepCards' subgrid. Decorative product UI: strings come from content.
 */
type Screen =
  | {
      kind: 'form';
      lang?: string;
      fields: { label: string; value: string }[];
      suggestion?: { label: string; items: { label: string; value: string }[] };
    }
  | { kind: 'message'; lang?: string; from: string; to: string; subject: string; body: string; actions: string[] }
  | {
      kind: 'status';
      lang?: string;
      title: string;
      rows: { label: string; value: string; highlight: boolean }[];
      total?: { label: string; value: string };
    };

interface Props {
  screen: Screen;
}
const { screen: s } = Astro.props;
const initials = (name: string) =>
  name
    .split(/\s+/)
    .map((w) => w[0])
    .join('')
    .slice(0, 2)
    .toUpperCase();
---

<div class="screen" data-kind={s.kind} data-theme="light" lang={s.lang}>
  {
    s.kind === 'form' && (
      <>
        <div class="fields">
          {s.fields.map((f) => (
            <div class="field">
              <span class="label">{f.label}</span>
              <span class="input">{f.value}</span>
            </div>
          ))}
        </div>
        {s.suggestion && (
          <div class="suggestions">
            <span class="label">{s.suggestion.label}</span>
            {s.suggestion.items.map((item) => (
              <span class="suggestion">
                <span>{item.label}</span>
                <strong>{item.value}</strong>
              </span>
            ))}
          </div>
        )}
      </>
    )
  }
  {
    s.kind === 'message' && (
      <>
        <div class="sender">
          <span class="avatar" aria-hidden="true">
            {initials(s.from)}
          </span>
          <span>
            <strong>{s.from}</strong>
            <span class="meta">{s.to}</span>
          </span>
        </div>
        <strong class="subject">{s.subject}</strong>
        <p class="body">{s.body}</p>
        <div class="actions">
          {s.actions.map((a, i) => (
            <span data-primary={i === 0 ? '' : undefined}>{a}</span>
          ))}
        </div>
      </>
    )
  }
  {
    s.kind === 'status' && (
      <>
        <strong class="title">{s.title}</strong>
        <dl class="rows">
          {s.rows.map((r) => (
            <div data-highlight={r.highlight ? '' : undefined}>
              <dt>{r.label}</dt>
              <dd>{r.value}</dd>
            </div>
          ))}
        </dl>
        {s.total && (
          <div class="total" data-theme="deep">
            <span>{s.total.label}</span>
            <strong>{s.total.value}</strong>
          </div>
        )}
      </>
    )
  }
</div>

<style>
  .screen {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
    padding: var(--space-m);
    border-radius: var(--radius-m);
    background-color: var(--color-bg-raised);
    box-shadow: var(--shadow-2);
    color: var(--color-text-base);
    font-size: var(--text-sm);
    line-height: var(--leading-sm);
  }

  .label,
  .meta {
    color: var(--color-text-subtle);
    font-size: var(--text-xs);
  }

  .label {
    font-weight: var(--font-weight-semibold);
  }

  .fields {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-2xs);
  }

  .field {
    display: flex;
    flex: 1 1 8rem;
    flex-direction: column;
    gap: var(--space-3xs);
  }

  .field:first-child {
    flex-basis: 100%;
  }

  .input {
    padding: var(--space-2xs) var(--space-xs);
    border: var(--size-hairline) solid var(--color-border-base);
    border-radius: var(--radius-control);
  }

  .suggestions {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
  }

  .suggestion {
    display: flex;
    justify-content: space-between;
    gap: var(--space-s);
    padding: var(--space-2xs) var(--space-xs);
    border-radius: var(--radius-s);
    background-color: var(--color-chip-bg);
  }

  .sender {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    padding-block-end: var(--space-s);
    border-block-end: var(--size-hairline) solid var(--color-border-base);
  }

  .sender > span:last-child {
    display: flex;
    flex-direction: column;
  }

  .avatar {
    display: grid;
    place-items: center;
    inline-size: var(--space-xl);
    block-size: var(--space-xl);
    flex-shrink: 0;
    border-radius: var(--radius-pill);
    background-color: var(--color-chip-bg);
    color: var(--color-accent-data-strong);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-bold);
  }

  .subject,
  .title {
    font-size: var(--text-base);
    font-weight: var(--font-weight-bold);
  }

  .body {
    color: var(--color-text-muted);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    margin-block-start: auto;
  }

  .actions span {
    padding: var(--space-2xs) var(--space-s);
    border: var(--size-hairline) solid var(--color-border-base);
    border-radius: var(--radius-control);
    font-weight: var(--font-weight-medium);
  }

  .actions [data-primary] {
    border-color: transparent;
    background-color: var(--color-text-base);
    color: var(--color-bg-raised);
    font-weight: var(--font-weight-semibold);
  }

  .rows {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
  }

  .rows div {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-s);
  }

  dt {
    color: var(--color-text-muted);
  }

  dd {
    margin: 0;
    color: var(--color-text-subtle);
    text-align: end;
  }

  [data-highlight] dt {
    color: var(--color-text-base);
    font-weight: var(--font-weight-bold);
  }

  [data-highlight] dd {
    padding: var(--space-3xs) var(--space-2xs);
    border-radius: var(--radius-tag);
    background-color: var(--color-accent-data);
    color: var(--color-on-data);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-bold);
  }

  .total {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-s);
    margin-block-start: auto;
    padding: var(--space-xs) var(--space-s);
    border-radius: var(--radius-s);
    background-color: var(--color-bg-base);
    color: var(--color-text-muted);
  }

  .total strong {
    color: var(--color-text-base);
    font-size: var(--text-lg);
    white-space: nowrap;
  }
</style>
