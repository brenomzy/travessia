---
/** The small product-UI picture on a feature card. One shape per vignette kind, strings from content. */
import type { CollectionEntry } from 'astro:content';
import Icon from '../ui/Icon.astro';

interface Props {
  vignette: CollectionEntry<'features'>['data']['vignette'];
}
const { vignette: v } = Astro.props;
---

<div class="vignette" data-kind={v.kind} data-theme="light">
  {
    v.kind === 'invoice' && (
      <div class="card" lang="en">
        <div class="row">
          <strong>{v.title}</strong>
          <span class="toggle">
            {v.languages.map((l, i) => (
              <span data-selected={i === 0 ? '' : undefined}>{l}</span>
            ))}
          </span>
        </div>
        <div class="lines">
          <span />
          <span />
        </div>
        <div class="row split">
          <strong class="big">{v.amount}</strong>
          <span class="pill">{v.action}</span>
        </div>
      </div>
    )
  }
  {
    v.kind === 'balances' && (
      <div class="balances">
        {v.rows.map((r) => (
          <div class="balance">
            <span>{r.label}</span>
            <strong>{r.amount}</strong>
          </div>
        ))}
        <div class="balance" data-theme="deep">
          <span>{v.convert.label}</span>
          <strong>{v.convert.amount}</strong>
        </div>
      </div>
    )
  }
  {
    v.kind === 'taxInvoice' && (
      <div class="card">
        <div class="issued">
          <span class="badge">
            <Icon name="check" />
          </span>
          <div>
            <strong>{v.title}</strong>
            <p class="meta">{v.meta}</p>
          </div>
        </div>
        <dl class="split">
          {v.rows.map((r) => (
            <div data-highlight={r.highlight ? '' : undefined}>
              <dt>{r.label}</dt>
              <dd>{r.value}</dd>
            </div>
          ))}
        </dl>
      </div>
    )
  }
  {
    v.kind === 'report' && (
      <div class="card">
        <div class="row baseline">
          <strong>{v.title}</strong>
          <span class="meta">{v.meta}</span>
        </div>
        <div class="bars">
          {v.bars.map((b, i) => (
            <span style={`--h: ${b}`} data-current={i === v.bars.length - 1 ? '' : undefined} />
          ))}
        </div>
        <div class="row split">
          <span class="muted">{v.footer.label}</span>
          <span class="highlight">{v.footer.value}</span>
        </div>
      </div>
    )
  }
</div>

<style>
  .vignette {
    display: flex;
    align-items: center;
    justify-content: center;
    min-block-size: 17.5rem;
    padding: var(--space-l) var(--space-m);
    background-color: var(--color-chip-bg);
    font-size: var(--text-sm);
    line-height: var(--leading-sm);
  }

  .card,
  .balances {
    inline-size: min(100%, 22.5rem);
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
    padding: var(--space-m);
    border-radius: var(--radius-m);
    background-color: var(--color-bg-raised);
    box-shadow: var(--shadow-2);
  }

  .row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-s);
  }

  .baseline {
    align-items: baseline;
  }

  .split {
    padding-block-start: var(--space-xs);
    border-block-start: var(--size-hairline) solid var(--color-border-base);
  }

  strong {
    font-size: var(--text-base);
    font-weight: var(--font-weight-bold);
  }

  .big {
    font-size: var(--text-xl);
  }

  .meta,
  .muted {
    color: var(--color-text-subtle);
    font-size: var(--text-xs);
  }

  .muted {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .highlight {
    color: var(--color-text-highlight);
    font-weight: var(--font-weight-semibold);
  }

  .toggle {
    display: flex;
    gap: var(--space-3xs);
    padding: var(--space-3xs);
    border-radius: var(--radius-pill);
    background-color: var(--color-chip-bg);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
  }

  .toggle span {
    padding-inline: var(--space-2xs);
    border-radius: var(--radius-pill);
  }

  .toggle [data-selected],
  .pill {
    background-color: var(--color-text-base);
    color: var(--color-bg-raised);
  }

  .pill {
    padding: var(--space-2xs) var(--space-s);
    border-radius: var(--radius-pill);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
  }

  .lines {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
  }

  .lines span {
    block-size: var(--size-dot);
    border-radius: var(--radius-pill);
    background-color: var(--color-border-base);
  }

  .lines span:first-child {
    inline-size: 80%;
  }

  .lines span:last-child {
    inline-size: 60%;
  }

  .balances {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .balance {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-s);
    padding: var(--space-s) var(--space-m);
    border-radius: var(--radius-s);
    background-color: var(--color-bg-raised);
    color: var(--color-text-subtle);
    font-weight: var(--font-weight-medium);
  }

  .balance[data-theme='deep'] {
    background-color: var(--color-bg-base);
    color: var(--color-text-muted);
  }

  .balance strong {
    color: var(--color-text-base);
    font-size: var(--text-lg);
  }

  .issued {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
  }

  .badge {
    display: grid;
    place-items: center;
    inline-size: var(--space-xl);
    block-size: var(--space-xl);
    flex-shrink: 0;
    border-radius: var(--radius-pill);
    background-color: var(--color-accent-data);
    color: var(--color-on-data);
  }

  dl {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
  }

  dl div {
    display: flex;
    justify-content: space-between;
  }

  dt {
    color: var(--color-text-muted);
  }

  dd {
    margin: 0;
    font-weight: var(--font-weight-semibold);
  }

  [data-highlight] dd {
    color: var(--color-text-highlight);
  }

  .bars {
    display: flex;
    align-items: flex-end;
    gap: var(--space-2xs);
    block-size: 5.625rem;
  }

  .bars span {
    flex: 1 1 0;
    block-size: calc(var(--h) * 100%);
    border-radius: var(--radius-s);
    background-color: var(--color-accent-data-soft);
  }

  .bars [data-current] {
    background-color: var(--color-accent-data-strong);
  }
</style>
