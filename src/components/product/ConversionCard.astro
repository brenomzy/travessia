---
/** Product UI: a conversion in progress (Paper: Components → Product UI pieces). */
import Icon from '../ui/Icon.astro';

interface Props {
  status: string;
  time: string;
  from: string;
  to: string;
  note: string;
  /** 0–1, how far the conversion bar is filled. */
  progress?: number;
  shadow?: 'raised' | 'floating-dark';
}
const { status, time, from, to, note, progress = 0.72, shadow = 'floating-dark' } = Astro.props;
---

<div class="conversion" data-theme="light" data-shadow={shadow} style={`--progress: ${progress}`}>
  <div class="head">
    <span class="status">{status}</span>
    <span class="time">{time}</span>
  </div>
  <div class="amounts">
    <span>{from}</span>
    <Icon name="arrow-right" />
    <span class="to">{to}</span>
  </div>
  <div class="bar"><span></span></div>
  <p class="note">{note}</p>
</div>

<style>
  .conversion {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    padding: var(--space-m) var(--space-m);
    border-radius: var(--radius-m);
    background-color: var(--color-bg-raised);
    color: var(--color-text-base);
  }

  [data-shadow='floating-dark'] {
    box-shadow: var(--shadow-3-on-dark);
  }

  [data-shadow='raised'] {
    box-shadow: var(--shadow-2);
  }

  .head,
  .amounts {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-s);
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-semibold);
  }

  .status::before {
    content: '';
    inline-size: var(--size-dot);
    block-size: var(--size-dot);
    border-radius: var(--radius-pill);
    background-color: var(--color-accent-data);
  }

  .time,
  .note {
    color: var(--color-text-subtle);
    font-size: var(--text-xs);
    line-height: var(--leading-xs);
  }

  .amounts {
    font-size: var(--text-lg);
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--font-tracking-title);
    font-variant-numeric: tabular-nums;
    color: var(--color-text-base);
  }

  .amounts :global(.icon) {
    color: var(--color-text-highlight);
  }

  .to {
    color: var(--color-text-highlight);
  }

  .bar {
    display: flex;
    block-size: var(--size-bar);
    overflow: hidden;
    border-radius: var(--radius-pill);
    background-color: var(--color-chip-bg);
  }

  .bar span {
    inline-size: calc(var(--progress) * 100%);
    border-radius: var(--radius-pill);
    background-color: var(--color-accent-data);
  }
</style>
