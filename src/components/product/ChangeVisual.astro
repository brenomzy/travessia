---
/** Small product UI beside a changelog entry (Paper: /novidades → rate alert, balances). */
import type { CollectionEntry } from 'astro:content';

interface Props {
  visual: NonNullable<CollectionEntry<'changelog'>['data']['visual']>;
}
const { visual: v } = Astro.props;
---

<div class="visual" data-theme="light" aria-hidden="true">
  {
    v.kind === 'rateAlert' && (
      <>
        <p class="row">
          <strong>{v.title}</strong>
          <span class="switch" />
        </p>
        <p class="rate">
          <span>{v.from}</span> <strong>{v.rate}</strong>
        </p>
        <p class="note">{v.note}</p>
      </>
    )
  }
  {
    v.kind === 'balances' && (
      <ul role="list" class="rows">
        {v.rows.map((r) => (
          <li>
            <span>
              {r.label} {r.badge && <span class="badge">{r.badge}</span>}
            </span>
            <strong>{r.amount}</strong>
          </li>
        ))}
      </ul>
    )
  }
</div>

<style>
  .visual {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    padding: var(--space-m);
    border: var(--size-hairline) solid var(--color-border-base);
    border-radius: var(--radius-m);
    background-color: var(--color-bg-raised);
    box-shadow: var(--shadow-2);
    color: var(--color-text-base);
    font-size: var(--text-sm);
    line-height: var(--leading-sm);
  }

  .row {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  /* A switch in the on position: a track with the knob on the right. */
  .switch {
    position: relative;
    inline-size: var(--space-l);
    block-size: var(--space-s);
    border-radius: var(--radius-pill);
    background-color: var(--color-accent-data-strong);
  }

  .switch::after {
    content: '';
    position: absolute;
    inset-block: var(--space-3xs);
    inset-inline-end: var(--space-3xs);
    aspect-ratio: 1;
    border-radius: var(--radius-pill);
    background-color: var(--color-bg-raised);
  }

  .rate span {
    color: var(--color-text-subtle);
  }

  .rate strong {
    font-size: var(--text-xl);
  }

  .note {
    color: var(--color-text-subtle);
    font-size: var(--text-xs);
  }

  .rows li {
    display: flex;
    justify-content: space-between;
    gap: var(--space-s);
    padding-block: var(--space-xs);
  }

  .rows li + li {
    border-block-start: var(--size-hairline) solid var(--color-border-base);
  }

  .rows span {
    color: var(--color-text-subtle);
  }

  .badge {
    margin-inline-start: var(--space-3xs);
    padding: 0 var(--space-2xs);
    border-radius: var(--radius-tag);
    background-color: var(--color-chip-bg);
    color: var(--color-chip-text);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
  }
</style>
