---
/**
 * How Travessia fixes one problem, drawn as a small piece of product UI (Paper: "Problem B · Problem beside its fix").
 * figure: a big value with a note or a segmented control. chips: a primary button and options. progress: states
 * leading to the highlighted last one. meter: a labelled bar. Decorative product UI: strings come from content.
 */
import Icon from '../ui/Icon.astro';

type Fix =
  | { kind: 'figure'; value: string; note?: string; tags?: string[] }
  | { kind: 'chips'; primary?: string; items: string[] }
  | { kind: 'progress'; items: string[]; done: string }
  | { kind: 'meter'; label: string; value: string; fraction: number };

interface Props {
  fix: Fix;
  lang?: string;
}
const { fix, lang } = Astro.props;
---

<div class="fix" data-kind={fix.kind} lang={lang}>
  {
    fix.kind === 'figure' && (
      <>
        <strong class="figure">{fix.value}</strong>
        {fix.tags && (
          <span class="segmented">
            {fix.tags.map((t, i) => (
              <span data-selected={i === 0 ? '' : undefined}>{t}</span>
            ))}
          </span>
        )}
        {fix.note && <span class="note">{fix.note}</span>}
      </>
    )
  }
  {
    fix.kind === 'chips' && (
      <>
        {fix.primary && <span class="chip" data-primary>{fix.primary}</span>}
        {fix.items.map((item) => (
          <span class="chip">{item}</span>
        ))}
      </>
    )
  }
  {
    fix.kind === 'progress' && (
      <>
        {fix.items.map((item) => (
          <>
            <span class="state">{item}</span>
            <span class="link" aria-hidden="true" />
          </>
        ))}
        <span class="done">
          <Icon name="check" />
          {fix.done}
        </span>
      </>
    )
  }
  {
    fix.kind === 'meter' && (
      <span class="meter">
        <span class="meter-head">
          <span>{fix.label}</span>
          <strong>{fix.value}</strong>
        </span>
        <span class="track" aria-hidden="true">
          <span style={`--fraction: ${fix.fraction}`} />
        </span>
      </span>
    )
  }
</div>

<style>
  .fix {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2xs) var(--space-xs);
    font-size: var(--text-sm);
    line-height: var(--leading-sm);
  }

  .figure {
    font-size: var(--text-xl);
    line-height: var(--leading-xl);
    font-weight: var(--font-weight-bold);
    font-variant-numeric: tabular-nums;
  }

  .note {
    flex-basis: 100%;
    color: var(--color-text-subtle);
  }

  .segmented {
    display: flex;
    gap: var(--space-3xs);
    padding: var(--space-3xs);
    border-radius: var(--radius-control);
    background-color: var(--color-bg-raised);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
  }

  .segmented span {
    padding-inline: var(--space-2xs);
    border-radius: calc(var(--radius-control) - var(--space-3xs));
  }

  .segmented [data-selected],
  .chip[data-primary] {
    background-color: var(--color-text-base);
    color: var(--color-bg-raised);
  }

  .chip {
    padding: var(--space-2xs) var(--space-s);
    border: var(--size-hairline) solid var(--color-border-base);
    border-radius: var(--radius-control);
    background-color: var(--color-bg-raised);
    font-weight: var(--font-weight-medium);
    white-space: nowrap;
  }

  .chip[data-primary] {
    border-color: transparent;
    font-weight: var(--font-weight-semibold);
  }

  .state {
    color: var(--color-text-subtle);
    font-weight: var(--font-weight-medium);
  }

  .link {
    inline-size: var(--space-m);
    block-size: var(--size-focus-ring);
    border-radius: var(--radius-pill);
    background-color: var(--color-accent-data-soft);
  }

  .done {
    --icon-size: var(--size-icon-s);
    display: inline-flex;
    align-items: center;
    gap: var(--space-3xs);
    padding: var(--space-3xs) var(--space-xs);
    border-radius: var(--radius-tag);
    background-color: var(--color-accent-data);
    color: var(--color-on-data);
    font-weight: var(--font-weight-bold);
    white-space: nowrap;
  }

  .meter {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    inline-size: min(100%, 22rem);
  }

  .meter-head {
    display: flex;
    justify-content: space-between;
    gap: var(--space-s);
    color: var(--color-text-subtle);
  }

  .meter-head strong {
    color: var(--color-text-base);
  }

  .track {
    display: block;
    block-size: var(--space-2xs);
    border-radius: var(--radius-pill);
    background-color: var(--color-bg-raised);
  }

  .track span {
    display: block;
    inline-size: calc(var(--fraction) * 100%);
    block-size: 100%;
    border-radius: inherit;
    background-color: var(--color-accent-data);
  }
</style>
