---
import type { GetStaticPaths } from 'astro';
import IntegrationPage from '../../../components/pages/IntegrationPage.astro';
import { getIntegrations } from '../../../lib/content';

export const getStaticPaths = (async () =>
  (await getIntegrations('en')).map((integration) => ({ params: { slug: integration.data.slug }, props: { integration } }))) satisfies GetStaticPaths;

const { integration } = Astro.props;
---

<IntegrationPage locale="en" integration={integration} />
